        <mxCell id="zoTHwajA6Q__5i3Qkb_1-35" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;Instance&lt;/span&gt;&lt;/h1&gt;&lt;div&gt;Instance là một phiên bản cụ thể được tạo ra từ Class&amp;nbsp;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Mỗi instance có dữ liệu riêng, tên riêng, nhưng hành vi xử lý logic thì giống nhau và được quy định từ class&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" parent="CaJl6Mu80ggbaKCv33ZO-13" vertex="1">
