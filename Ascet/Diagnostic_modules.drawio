        <mxCell id="zoTHwajA6Q__5i3Qkb_1-31" value="&lt;div&gt;Fid_FDTMU01D là tên của một instance (Đối tượng) (một phiên bản của Fid_Typ)&amp;nbsp;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Mục đích: mang hành vi xử lý của class sử dụng với module TMU01D&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="CaJl6Mu80ggbaKCv33ZO-13" vertex="1">
