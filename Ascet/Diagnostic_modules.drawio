        <mxCell id="zoTHwajA6Q__5i3Qkb_1-34" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Class&lt;/h1&gt;&lt;p&gt;Class là một &lt;b&gt;khuôn mẫu&lt;/b&gt; định nghĩa các &lt;b&gt;biến và hành vi (hàm/method) &lt;/b&gt;của một đối tượng&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;Class không chiếm bộ nhớ, chỉ là bản thiết kế để tạo ra nhiều &lt;/span&gt;&lt;b style=&quot;background-color: initial;&quot;&gt;đối tượng (instance)&lt;/b&gt;&lt;span style=&quot;background-color: initial;&quot;&gt; cụ thể.&lt;/span&gt;&lt;br&gt;&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" parent="CaJl6Mu80ggbaKCv33ZO-13" vertex="1">
