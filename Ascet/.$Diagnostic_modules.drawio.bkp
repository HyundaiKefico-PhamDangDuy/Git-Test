        <mxCell id="zoTHwajA6Q__5i3Qkb_1-34" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Class&lt;/h1&gt;&lt;p&gt;Class là một &lt;b&gt;khuôn mẫu&lt;/b&gt; định nghĩa các &lt;b&gt;biến và hành vi (hàm/method) &lt;/b&gt;của một đối tượng&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;Class không chiếm bộ nhớ, chỉ là bản thiết kế để tạo ra nhiều &lt;/span&gt;&lt;b style=&quot;background-color: initial;&quot;&gt;đối tượng (instance)&lt;/b&gt;&lt;span style=&quot;background-color: initial;&quot;&gt; cụ thể.&lt;/span&gt;&lt;br&gt;&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" parent="CaJl6Mu80ggbaKCv33ZO-13" vertex="1">
          <mxGeometry x="200" y="460.00000000000006" width="190" height="170" as="geometry" />
        </mxCell>
        <mxCell id="zoTHwajA6Q__5i3Qkb_1-35" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;Instance&lt;/span&gt;&lt;/h1&gt;&lt;div&gt;Instance là một phiên bản cụ thể được tạo ra từ Class&amp;nbsp;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Mỗi instance có dữ liệu riêng, tên riêng, nhưng hành vi xử lý logic thì giống nhau và được quy định từ class&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" parent="CaJl6Mu80ggbaKCv33ZO-13" vertex="1">
          <mxGeometry x="440" y="460.00000000000006" width="190" height="160" as="geometry" />
        </mxCell>
        <mxCell id="zoTHwajA6Q__5i3Qkb_1-36" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Trong Ascet - Block diagram&lt;/h1&gt;&lt;div&gt;Mỗi instance được tạo ra cần tạo một block instance mới&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Không thể tạo chung một block class rồi truyền tên của instance vào được&amp;nbsp;&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" parent="CaJl6Mu80ggbaKCv33ZO-13" vertex="1">
